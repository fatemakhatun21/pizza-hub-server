# Copy to .env for local development.
# On Render, set these in the service Environment tab (never commit real secrets).

PORT=5000
NODE_ENV=development

# Optional comma-separated DNS resolvers. Local development defaults to
# 8.8.8.8,1.1.1.1 when this is empty; production uses the platform DNS.
DNS_SERVERS=

MONGODB_URI=

# Public URL of this API (Render service URL in production)
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=

# Public URL of the Next.js frontend (Vercel URL in production)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe premium subscription ($10/month)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

IMGBB_API_KEY=

# Order status emails (Resend REST API, no extra dependency).
# RESEND_API_KEY and a verified EMAIL_FROM are both required; without them,
# no test emails are sent. CLIENT_URL is reused for the optional order link.
RESEND_API_KEY=
EMAIL_FROM=PizzaHub <orders@your-verified-domain.example>

# Optional and test-only. Used by test/vendorItemLimit.test.js for a
# MongoDB-backed integration test; not needed in production. Use a disposable
# test database placeholder, never real credentials.
TEST_MONGODB_URI=mongodb://localhost:27017/pizzahub_limit_test
